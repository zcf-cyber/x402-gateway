# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL
DATABASE_URL=postgresql://x402:x402local@localhost:5432/x402_gateway

# Redis
REDIS_URL=redis://localhost:6379

# x402 Challenge Signing
CHALLENGE_SECRET=replace-with-random-64-char-hex
CHALLENGE_TTL_SECONDS=300

# Merchant / Payment
MERCHANT_ADDRESS=0x_your_merchant_address_here
PAYMENT_CHAIN=base
PAYMENT_ASSET=USDC

# Upstream Provider Keys
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
MINIMAX_API_KEY=...
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MOONSHOT_API_KEY=sk-...
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
ZHIPU_API_KEY=...
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Platform Fee (basis points, 500 = 5%)
PLATFORM_FEE_BPS=500
